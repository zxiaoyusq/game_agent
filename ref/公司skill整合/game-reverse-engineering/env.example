# env.example —— 部署前把下面占位符替换为这台电脑的真实路径
# 用法：在 Windows 设置-环境变量里按名字建变量（不要带 ${ }），或在本文件按需复制改名成 .env
# 分隔符建议用正斜杠 /；本文件是配置示例，不会被 PowerShell 自动加载。
# COCOS_* / SDK / NDK / PLATFORM_TOOLS / BUILD_TOOLS 为目录；NDK 已含版本。
# ASSETRIPPER / SPINE_VIEWER / GODOT 为完整可执行文件或 JAR 路径。

# === 游戏引擎 / 编辑器 ===
COCOS_2X=/path/to/CocosCreator_2.4.13
COCOS_3X=/path/to/CocosCreator_3.8.7
COCOS_DASHBOARD=/path/to/CocosDashboard

# === Android 构建 ===
ANDROID_SDK=/path/to/AndroidSdk
ANDROID_NDK=/path/to/AndroidSdk/ndk/23.2.8568313
ANDROID_PLATFORM_TOOLS=/path/to/AndroidSdk/platform-tools
ANDROID_BUILD_TOOLS=/path/to/AndroidSdk/build-tools/34.0.0
JAVA_HOME=/path/to/jdk-17

# === 逆向工具 ===
ASSETRIPPER=/path/to/AssetRipper/AssetRipper.GUI.Free.exe
IL2CPP_INSPECTOR=/path/to/Il2CppInspectorRedux
PYLIBS=/path/to/pylibs
SPINE_VIEWER=/path/to/skeletonViewer-3.8.99.jar

# === Godot ===
GODOT=/path/to/Godot_v4.6.2-stable_win64.exe

# === 可选：harness 同步目录（只在你需要多端同步时配置） ===
HARNESS_CLAUDE=/path/to/.claude/skills
HARNESS_CODEX=/path/to/.codex/skills
HARNESS_OPENCODE=/path/to/.config/opencode/skills
HARNESS_DSH=/path/to/.dsh/skills
HARNESS_ZCODE=/path/to/.zcode/skills
HARNESS_WORKBUDDY=/path/to/.workbuddy/skills
HARNESS_AGENTS=/path/to/.agents/skills
HARNESS_TRAE=/path/to/.trae/skills
HARNESS_TRAE_CN=/path/to/.trae-cn/skills
HARNESS_QWENWORK_CN=/path/to/.qwenworkcn/skills
HARNESS_WORKBUDDY_AI=/path/to/.workbuddy-ai/skills
HARNESS_OPENCODE_D=/path/to/opencode-d/skills

# === 3D 资产逆向的第三方工具（按需） ===
ANVIL_TOOLS=/path/to/anvil-tools
FROMSOFT_TOOLS=/path/to/fromsoft-tools
NIER_TOOLS=/path/to/nier-tools
AQUA_TOOLSET=/path/to/Aqua_Toolset
UE_AUDIT=/path/to/ue-audit